# ==============================================================================
# WeddingOS — Master Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - apps/web/.env
#   - services/api (or configure in Render dashboard)
# NEVER commit files containing real keys, passwords, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (apps/web/.env)
# ------------------------------------------------------------------------------
# Clerk Authentication Publishable Key (Safe for browser client)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend REST API Base URL
VITE_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT (services/api / Render Dashboard)
# ------------------------------------------------------------------------------
# Server Port
PORT=8080

# Relational Database Connection (MySQL 8.0 / TiDB Serverless)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/weddingos_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Clerk Authentication Issuer URL & Backend Security
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://wedding-os-tap.vercel.app,http://localhost:5173
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Cloudinary Storage Connection String (for Guest Photo Uploads)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
